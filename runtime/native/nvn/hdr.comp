#version 450
// The finished picture (8 bits a channel, sRGB) made a high dynamic range one on its way to the display (the settings
// window's HDR rows). The game's own picture ends at paper white; this pass gives it the display's range above that: the
// values are made linear, everything up to a knee is shown as it is at the chosen paper-white brightness, and what is
// brighter than the knee is raised towards the display's peak, the more the brighter it is (hue kept: the three
// channels by one factor). PQ variant (-DPQ): BT.2020 primaries, the SMPTE ST 2084 curve, for an HDR10 surface;
// otherwise scRGB: linear BT.709 with 1.0 at 80 nits, for an extended-sRGB surface.
layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 0) uniform sampler2D src;
#ifdef PQ
layout(binding = 1, rgb10_a2) uniform writeonly image2D dst;
#else
layout(binding = 1, rgba16f) uniform writeonly image2D dst;
#endif
layout(push_constant) uniform Push { float paper; float peak; float strength; float knee; } push;
vec3 to_linear(vec3 c) { return mix(c / 12.92, pow((c + 0.055) / 1.055, vec3(2.4)), greaterThan(c, vec3(0.04045))); }
void main() {
    const ivec2 at = ivec2(gl_GlobalInvocationID.xy);
    const ivec2 size = imageSize(dst);
    if (at.x >= size.x || at.y >= size.y) return;
    vec3 c = to_linear(texelFetch(src, at, 0).rgb);
    const float top = max(c.r, max(c.g, c.b));
    const float t = clamp((top - push.knee) / max(1.0 - push.knee, 1e-3), 0.0, 1.0);
    const float gain = 1.0 + (push.peak / push.paper - 1.0) * push.strength * t * t;
    vec3 nits = c * gain * push.paper;
#ifdef PQ
    const mat3 to2020 = mat3(0.6274, 0.0691, 0.0164, 0.3293, 0.9195, 0.0880, 0.0433, 0.0114, 0.8956);
    const vec3 y = pow(clamp(to2020 * nits, 0.0, 10000.0) / 10000.0, vec3(0.1593017578125));
    const vec3 pq = pow((0.8359375 + 18.8515625 * y) / (1.0 + 18.6875 * y), vec3(78.84375));
    imageStore(dst, at, vec4(pq, 1.0));
#else
    imageStore(dst, at, vec4(nits / 80.0, 1.0));
#endif
}
