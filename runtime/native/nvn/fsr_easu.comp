#version 450
// FSR 1 EASU (AMD FidelityFX, MIT: third_party/fsr1): the game's frame upscaled to the window.
#extension GL_GOOGLE_include_directive : enable
#define A_GPU 1
#define A_GLSL 1
#include "ffx_a.h"
layout(push_constant) uniform Push { uvec4 Const0; uvec4 Const1; uvec4 Const2; uvec4 Const3; };
layout(binding = 0) uniform sampler2D InputTexture;
layout(binding = 1, rgba8) uniform writeonly image2D OutputTexture;
#define FSR_EASU_F 1
AF4 FsrEasuRF(AF2 p) { return AF4(textureGather(InputTexture, p, 0)); }
AF4 FsrEasuGF(AF2 p) { return AF4(textureGather(InputTexture, p, 1)); }
AF4 FsrEasuBF(AF2 p) { return AF4(textureGather(InputTexture, p, 2)); }
#include "ffx_fsr1.h"
layout(local_size_x = 64) in;
void Filter(AU2 pos) { AF3 c; FsrEasuF(c, pos, Const0, Const1, Const2, Const3); imageStore(OutputTexture, ASU2(pos), AF4(c, 1)); }
void main() {
    AU2 gxy = ARmp8x8(gl_LocalInvocationID.x) + AU2(gl_WorkGroupID.x << 4u, gl_WorkGroupID.y << 4u);
    Filter(gxy); gxy.x += 8u; Filter(gxy); gxy.y += 8u; Filter(gxy); gxy.x -= 8u; Filter(gxy);
}
