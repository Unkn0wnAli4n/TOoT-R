#version 450
// From Hookshot (github.com/NotRexed/Hookshot, gpu/vk/shaders/fg_scale.comp, GPL-3.0-or-later): the game's frame
// to the window's size, Catmull-Rom or Lanczos 2, then a contrast-limited sharpen (no halos).
layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 0) uniform sampler2D src;
layout(binding = 1) uniform writeonly image2D dst; // (no format: the window's RGBA8 and the game's own float targets, render.cpp's stand-in)
layout(push_constant) uniform P { int mode; float sharp; int decode; } pc; // (decode 1: the result from sRGB encoding to linear values)
const float PI = 3.14159265;
float lanczos2(float x) {
    x = abs(x);
    if (x < 1e-4) return 1.0;
    if (x >= 2.0) return 0.0;
    const float p = PI * x;
    return 2.0 * sin(p) * sin(p * 0.5) / (p * p);
}
float catmull(float x) {
    x = abs(x);
    if (x < 1.0) return 1.5 * x * x * x - 2.5 * x * x + 1.0;
    if (x < 2.0) return -0.5 * x * x * x + 2.5 * x * x - 4.0 * x + 2.0;
    return 0.0;
}
vec3 filtered(vec2 uv) {
    if (pc.mode == 0) return textureLod(src, uv, 0.0).rgb;
    const vec2 size = vec2(textureSize(src, 0));
    const vec2 p = uv * size - 0.5;
    const ivec2 b = ivec2(floor(p));
    const vec2 f = p - vec2(b);
    vec3 sum = vec3(0.0);
    float weight = 0.0;
    for (int y = -1; y <= 2; y++)
        for (int x = -1; x <= 2; x++) {
            const vec2 d = vec2(x, y) - f;
            const float w = pc.mode == 2 ? lanczos2(d.x) * lanczos2(d.y) : catmull(d.x) * catmull(d.y);
            sum += w * texelFetch(src, clamp(b + ivec2(x, y), ivec2(0), ivec2(size) - 1), 0).rgb;
            weight += w;
        }
    return sum / weight;
}
void main() {
    const ivec2 g = ivec2(gl_GlobalInvocationID.xy);
    const ivec2 d = imageSize(dst);
    if (any(greaterThanEqual(g, d))) return;
    const vec2 uv = (vec2(g) + 0.5) / vec2(d);
    vec3 c = filtered(uv);
    if (pc.sharp > 0.0) {
        const vec2 e = 1.0 / vec2(d);
        const vec3 n = textureLod(src, uv + vec2(0.0, -e.y), 0.0).rgb, s = textureLod(src, uv + vec2(0.0, e.y), 0.0).rgb;
        const vec3 w = textureLod(src, uv + vec2(-e.x, 0.0), 0.0).rgb, r = textureLod(src, uv + vec2(e.x, 0.0), 0.0).rgb;
        const vec3 lo = min(min(min(n, s), min(w, r)), c), hi = max(max(max(n, s), max(w, r)), c);
        // (up to 100%: never past the neighbourhood's range, so no halos. Above it the limit is let out by the excess,
        // a share of that range: the stronger setting for the soft picture of a temporal upscaler)
        const vec3 slack = (hi - lo) * max(pc.sharp - 1.0, 0.0) * 0.5;
        c = clamp(c + pc.sharp * 1.5 * (c - (n + s + w + r) * 0.25), lo - slack, hi + slack);
    }
    if (pc.decode == 2) c = c * c; // (the game's scene as its upscaling network takes it: square roots of the linear values)
    if (pc.decode == 1) c = mix(c / 12.92, pow((max(c, vec3(0.0)) + 0.055) / 1.055, vec3(2.4)), step(vec3(0.04045), c));
    imageStore(dst, g, vec4(c, 1.0));
}
